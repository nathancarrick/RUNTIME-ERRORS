# =========================================================
# LOGIAID — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your local credentials.
# =========================================================

# Application Environment
APP_ENV=development
APP_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logiaid
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

# Frontend Origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Email (SMTP) Configuration (Optional - for real email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS Provider Configuration (Optional - for real SMS delivery)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Mapping & Routing Services
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LOGIAID/1.0 (HackNext26 Disruption-Aware Logistics)

# Profile Photo Storage
PROFILE_UPLOAD_DIR=uploads/profiles
MAX_PROFILE_IMAGE_MB=3
